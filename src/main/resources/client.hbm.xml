<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="entities.Client" table="CLIENT">
        <id name="id" type="long">
            <column name="ID_CLIENT"/>
            <generator class="native"/>
        </id>
        <property name="firstName" type="string" not-null="true">
            <column name="FN_CLIENT"/>
        </property>
        <property name="lastName" type="string" not-null="true">
            <column name="LN_CLIENT"/>
        </property>
        <property name="dateNaissance" type="date">
            <column name="DATE_NAISSANCE"/>
        </property>
        <set name="comptes" table="COMPTE" inverse="true" lazy="true">
            <key><column name="ID_CLIENT"/></key>
            <one-to-many class="entities.Compte"/>
        </set>
    </class>
</hibernate-mapping>